# Entorno
NODE_ENV=development
TZ=America/Bogota

# API
PORT=4000
WORKER=0

# Base de datos
DATABASE_URL=postgresql://santaisabel:santaisabel@localhost:5432/santaisabel?schema=public

# Redis (BullMQ, cache, refresh tokens)
REDIS_URL=redis://localhost:6379

# JWT (genera secretos de al menos 32 caracteres con `openssl rand -hex 32`)
JWT_SECRET=change-me-please-32-chars-minimum-aaaaaaaa
JWT_REFRESH_SECRET=change-me-please-32-chars-minimum-bbbbbbb
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# URLs públicas
WEB_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_INTERNAL_URL=http://localhost:4000

# NextAuth (frontend)
NEXTAUTH_SECRET=change-me-32-chars-minimum-ccccccccccccc
NEXTAUTH_URL=http://localhost:3000

# Cloudflare R2 (deja vacío en desarrollo local)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

# Observabilidad (opcional)
SENTRY_DSN=
AXIOM_TOKEN=

# SMTP (opcional, para password reset)
SMTP_URL=

# Seed
SEED_ADMIN_EMAIL=admin@santaisabel.local
SEED_ADMIN_PASSWORD=Admin12345!
