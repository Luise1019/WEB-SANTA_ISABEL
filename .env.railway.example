# ── Variables de entorno para Railway ─────────────────────────
# Copiar estas variables en el dashboard de Railway por servicio
# railway.app → Tu proyecto → Service → Variables

# ════════════════════════════════════════
# SERVICIO: api
# ════════════════════════════════════════
NODE_ENV=production
TZ=America/Bogota
PORT=4000
WORKER=0

# Railway inyecta DATABASE_URL automáticamente si usas el plugin Postgres
# (no necesitas escribirla manualmente)
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Railway inyecta REDIS_URL automáticamente si usas el plugin Redis
REDIS_URL=${{Redis.REDIS_URL}}

# ⚠️  CAMBIAR ESTOS VALORES EN PRODUCCIÓN (generar con: openssl rand -hex 32)
JWT_SECRET=CAMBIAR-este-secreto-a-algo-aleatorio-de-64-chars
JWT_REFRESH_SECRET=CAMBIAR-este-otro-secreto-aleatorio-64-chars

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# URL pública del servicio web (Railway te la da al crear el servicio web)
WEB_PUBLIC_URL=https://${{web.RAILWAY_PUBLIC_DOMAIN}}

# ════════════════════════════════════════
# SERVICIO: web
# ════════════════════════════════════════
NODE_ENV=production
TZ=America/Bogota

# Proxy interno: el web llama /api/v1/* y Next.js lo reescribe a la API interna
# Railway tiene red interna entre servicios del mismo proyecto
NEXT_PUBLIC_API_URL=/api/v1
API_INTERNAL_URL=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:4000
